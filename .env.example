# ============================================================
# FIDELIS / CANON Platform Environment Configuration
# ============================================================

# Application Environment: 'development' | 'production' | 'test'
ENVIRONMENT=development

# Cryptographic JWT Secret Key (MUST be at least 32 characters in production)
# Generate with: python scripts/generate_secret.py
SECRET_KEY=canon-hackathon-super-secret-key-change-in-production

# Security Flags
# Set to 'false' in production. Must be false when ENVIRONMENT=production.
ENABLE_DEV_PERSONA_SWITCHING=true
ENABLE_DEMO_ACCOUNTS=true

# ============================================================
# Database Configuration
# ============================================================
# SQLite (Local Dev / Single Instance):
DATABASE_URL=sqlite:///./canon.db

# PostgreSQL (Production / Multi-Instance Recommended):
# DATABASE_URL=postgresql://fidelis_user:strong_password@localhost:5432/fidelis_db

DEFAULT_WORKSPACE_ID=ws-apexdynamics-001

# ============================================================
# CORS Allowed Origins
# In production, specify exact origins (comma-separated, NO WILDCARD with credentials):
# Example: https://fidelis.yourdomain.com
# ============================================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================
# LLM Provider Configuration (Cloud Open-Source / Local Ollama)
# ============================================================
# Provider Mode:
# - 'huggingface': Use Hugging Face Serverless / Regional API
# - 'ollama': Use Local Ollama daemon running on local PC
# - 'auto': Uses Hugging Face if HF_TOKEN is present; otherwise attempts local Ollama
LLM_PROVIDER=auto

# Hugging Face Settings (Pre-Trained Open-Source Model: Qwen 2.5)
# Obtain token at: https://huggingface.co/settings/tokens
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
# Region option: 'auto', 'us-east-1', 'eu-west-1', 'ap-southeast-1'
HF_REGION=auto
# Optional: Dedicated Inference Endpoint URL
HF_ENDPOINT_URL=
HF_TIMEOUT_SECONDS=45.0

# Local Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_FALLBACK_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=45.0

# Fallback to deterministic heuristic if provider is unreachable
ALLOW_MOCK_LLM_FALLBACK=true

# ============================================================
# File Upload Limits
# ============================================================
MAX_UPLOAD_SIZE_MB=15
MAX_ASSET_UPLOAD_SIZE_MB=25
