# ============================================================
# CANON / FIDELIS Platform Environment Configuration
# ============================================================

# Environment: 'development' | 'production' | 'test'
ENVIRONMENT=development
SECRET_KEY=canon-hackathon-super-secret-key-change-in-production

# ============================================================
# Pre-Trained Open-Source LLM Provider (Hugging Face / Ollama)
# ============================================================
# Provider Mode:
# - 'huggingface': Use Hugging Face Serverless / Regional API (Recommended for Render & Vercel)
# - 'ollama': Use Local Ollama daemon running on local PC
# - 'auto': Uses Hugging Face if HF_TOKEN is present; otherwise attempts local Ollama
LLM_PROVIDER=auto

# Hugging Face Settings (Pre-Trained Open-Source Model: Qwen 2.5)
# Get your free access token at: https://huggingface.co/settings/tokens
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
# Region option: 'auto', 'us-east-1', 'eu-west-1', 'ap-southeast-1'
HF_REGION=auto
# Optional: Dedicated Inference Endpoint URL (if hosting in a specific cloud/region)
# Example: https://xxxx.us-east-1.endpoints.huggingface.cloud/v1
HF_ENDPOINT_URL=
HF_TIMEOUT_SECONDS=45.0

# Local Ollama Fallback (for local PC execution)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_FALLBACK_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=45.0

# Fallback to deterministic rule heuristic if offline / mock mode
ALLOW_MOCK_LLM_FALLBACK=true

# ============================================================
# Database & Security
# ============================================================
DATABASE_URL=sqlite:///./canon.db
DEFAULT_WORKSPACE_ID=ws-apexdynamics-001

# CORS Allowed Origins (Comma-separated in production or '*' for open access)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,*
